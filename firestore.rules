rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /questLogs/{logId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.readerIds;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.ownerId
                        || request.auth.uid in resource.data.editorIds);
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;
    }

    match /pathways/{pathwayId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /quests/{questId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /crews/{crewId} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.memberIds;
      }
      function inCrew() {
        return request.auth != null
               && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;
      }

      allow read: if isMember();
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId
                    && request.resource.data.memberIds == [request.auth.uid];
      allow update: if request.auth != null
                    && (isMember()
                        || (request.resource.data.memberIds.hasAll(resource.data.memberIds)
                            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                            && request.auth.uid in request.resource.data.memberIds));
      allow delete: if false;

      match /members/{memberId} {
        allow read: if inCrew();
        allow write: if request.auth != null && request.auth.uid == memberId;
      }

      match /feed/{entryId} {
        allow read: if inCrew();
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorId;
        allow update: if inCrew()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedBy'])
                      && request.resource.data.approvedBy.hasAll(resource.data.approvedBy);
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.authorId;
      }

      match /messages/{messageId} {
        allow read: if inCrew();
        allow create: if inCrew()
                      && request.auth.uid == request.resource.data.authorId
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.authorId;
      }
    }

    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /pathwayProgress/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
