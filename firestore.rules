rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{sub=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /questLogs/{logId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.readerIds;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.ownerId
                        || (request.auth.uid in resource.data.editorIds
                            && request.resource.data.ownerId == resource.data.ownerId
                            && request.resource.data.readerIds == resource.data.readerIds
                            && request.resource.data.editorIds == resource.data.editorIds));
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.ownerId;
    }

    match /taskCatalog/{taskId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /pathways/{pathwayId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /quests/{questId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /crews/{crewId} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.memberIds;
      }
      function inCrew() {
        return request.auth != null
               && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.memberIds;
      }
      function onlyMembersChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
      }
      function joiningSelf() {
        return !(request.auth.uid in resource.data.memberIds)
               && request.auth.uid in request.resource.data.memberIds
               && request.resource.data.memberIds.hasAll(resource.data.memberIds)
               && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
               && request.resource.data.memberIds.size() <= 12;
      }
      function leavingSelf() {
        return request.auth.uid in resource.data.memberIds
               && !(request.auth.uid in request.resource.data.memberIds)
               && resource.data.memberIds.hasAll(request.resource.data.memberIds)
               && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1;
      }
      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerId;
      }
      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function ownerRemovingMember() {
        return isOwner()
               && changedKeys().hasOnly(['memberIds'])
               && resource.data.memberIds.hasAll(request.resource.data.memberIds)
               && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
               && request.auth.uid in request.resource.data.memberIds;
      }
      function ownerEditingCrew() {
        return isOwner()
               && changedKeys().hasOnly(['name', 'inviteCode', 'ownerId'])
               && request.resource.data.name is string
               && request.resource.data.name.size() >= 3
               && request.resource.data.name.size() <= 40
               && request.resource.data.inviteCode is string
               && request.resource.data.inviteCode.size() == 6
               && request.resource.data.ownerId in resource.data.memberIds;
      }

      allow read: if isMember();
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.ownerId
                    && request.resource.data.memberIds == [request.auth.uid];
      allow update: if request.auth != null
                    && ((onlyMembersChanged() && (joiningSelf() || leavingSelf()))
                        || ownerRemovingMember()
                        || ownerEditingCrew());
      allow delete: if isOwner()
                    && resource.data.memberIds == [request.auth.uid];

      match /members/{memberId} {
        allow read: if inCrew();
        allow create, update: if request.auth != null && request.auth.uid == memberId;
        allow delete: if request.auth != null
                      && (request.auth.uid == memberId
                          || get(/databases/$(database)/documents/crews/$(crewId))
                             .data.ownerId == request.auth.uid);
      }

      match /feed/{entryId} {
        allow read: if inCrew();
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorId;
        allow update: if inCrew()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedBy'])
                      && request.resource.data.approvedBy.hasAll(resource.data.approvedBy)
                      && request.resource.data.approvedBy.size() == resource.data.approvedBy.size() + 1
                      && request.auth.uid in request.resource.data.approvedBy
                      && !(request.auth.uid in resource.data.approvedBy);
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.authorId;
      }

      match /messages/{messageId} {
        allow read: if inCrew();
        allow create: if inCrew()
                      && request.auth.uid == request.resource.data.authorId
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500;
        allow update: if false;
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.authorId;
      }
    }

    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['crewId'])
                    && request.resource.data.crewId is string
                    && exists(/databases/$(database)/documents/crews/$(request.resource.data.crewId))
                    && get(/databases/$(database)/documents/crews/$(request.resource.data.crewId))
                       .data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null
                    && exists(/databases/$(database)/documents/crews/$(resource.data.crewId))
                    && get(/databases/$(database)/documents/crews/$(resource.data.crewId))
                       .data.ownerId == request.auth.uid;
    }

    match /pathwayProgress/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && docId == request.auth.uid + '_' + request.resource.data.pathwayId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
